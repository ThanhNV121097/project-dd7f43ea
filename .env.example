# Local database username for docker compose.
POSTGRES_USER=app

# Local database password for docker compose.
POSTGRES_PASSWORD=app_secret

# Local database name for docker compose.
POSTGRES_DB=app

# Backend host port.
BACKEND_PORT=8080

# Frontend host port.
FRONTEND_PORT=3000

# Browser API base URL for frontend builds.
NEXT_PUBLIC_API_URL=http://localhost:8080
